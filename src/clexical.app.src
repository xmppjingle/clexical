{application, clexical,
    [
        {description, "Clexical — Event-Driven Backend: HTTP REST, Permanent Automations, Pluggable Herald/Scribe/Vassal"},
        {vsn, "0.2.0"},
        {registered, [clexical, clexical_sup, clexical_services_sup,
                      clexical_id, clexical_notifier,
                      http_herald, automation_vassal, webhook_vassal]},
        {applications, [
            kernel,
            stdlib,
            crypto,
            inets,
            ssl,
            xmerl,
            mnesia,
            cowboy,
            jsone,
            bbmustache
        ]},
        {mod, {clexical_app, []}},
        {env, [
            %% Override via sys.config or OS environment variables:
            %%   CLEXICAL_HTTP_PORT   (default 8080)
            %%   CLEXICAL_API_KEY     (default "changeme")
            %%   CLEXICAL_MNESIA_DIR  (default /tmp/clexical_mnesia)
        ]}
    ]}.
