%% rebar3 configuration — modernized for OTP 26+

{erl_opts, [
    debug_info,
    {parse_transform, lager_transform},
    {i, "include"}
]}.

{deps, [
    %% HTTP server
    {cowboy, "2.10.0"},
    %% JSON encoding/decoding
    {jsone, "1.8.1"},
    %% Logging (lager 3.9+, compatible with OTP 25/26)
    {lager, "3.9.2"},
    %% Mustache templates
    {bbmustache, {git, "https://github.com/xmppjingle/bbmustache.git", {branch, "master"}}},
    %% UUID generation
    {uuid, {git, "https://github.com/okeuday/uuid.git", {tag, "v2.0.6"}}}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [clexical]}
]}.

{relx, [
    {release, {clexical, "0.2.0"}, [clexical]},
    {mode, prod},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {include_erts, true},
    {extended_start_script, true}
]}.

{profiles, [
    {dev, [
        {relx, [{mode, dev}, {include_erts, false}]},
        {erl_opts, [debug_info]}
    ]},
    {test, [
        {deps, [
            {meck, "0.9.2"}
        ]},
        {erl_opts, [debug_info, {d, 'TEST'}]}
    ]}
]}.

{cover_enabled, true}.
{cover_print_enabled, true}.
