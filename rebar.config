%% rebar3 configuration — OTP 25/26
%% All deps sourced from GitHub (no hex.pm required for build).
%% Logging via OTP's built-in logger; lager is available only in xmpp profile.

{erl_opts, [
    debug_info,
    {i, "include"}
]}.

{deps, [
    %% HTTP server
    {cowboy,  {git, "https://github.com/ninenines/cowboy.git", {tag, "2.12.0"}}},
    {cowlib,  {git, "https://github.com/ninenines/cowlib.git", {tag, "2.13.0"}}},
    {ranch,   {git, "https://github.com/ninenines/ranch.git",  {tag, "2.1.0"}}},
    %% JSON
    {jsone,   {git, "https://github.com/sile/jsone.git",       {tag, "1.9.0"}}},
    %% Mustache templates
    {bbmustache, {git, "https://github.com/xmppjingle/bbmustache.git",
                       {branch, "master"}}}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps,   [clexical]}
]}.

{relx, [
    {release, {clexical, "0.2.0"}, [clexical]},
    {mode,       prod},
    {sys_config, "config/sys.config"},
    {vm_args,    "config/vm.args"},
    {include_erts,          true},
    {extended_start_script, true}
]}.

{profiles, [
    {dev, [
        {relx,     [{mode, dev}, {include_erts, false}]},
        {erl_opts, [debug_info]}
    ]},
    {test, [
        {deps,     [{meck, {git, "https://github.com/eproxus/meck.git",
                            {tag, "0.9.2"}}}]},
        {erl_opts, [debug_info, {d, 'TEST'}]}
    ]},
    %% xmpp profile: XMPP herald for XMPP-based deployments.
    %% Usage: rebar3 as xmpp compile
    {xmpp, [
        {src_dirs, ["src", "src_xmpp"]},
        {erl_opts, [
            debug_info,
            {parse_transform, lager_transform},
            {i, "include"},
            {i, "deps/fast_xml/include"},
            {i, "deps/xmpp/include"}
        ]},
        {deps, [
            {lager,   {git, "https://github.com/erlang-lager/lager.git", {tag, "3.9.2"}}},
            {fast_xml,{git, "https://github.com/processone/fast_xml.git",{branch, "master"}}},
            {xmpp,    {git, "https://github.com/processone/xmpp.git",    {branch, "master"}}},
            {snatch,  {git, "https://github.com/xmppjingle/snatch.git",  {branch, "master"}}}
        ]}
    ]}
]}.

{cover_enabled,       true}.
{cover_print_enabled, true}.
